<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- ОБЯЗАТЕЛЬНЫЙ ИМПОРТ -->
<?import net.eternallauncher.ui.background.SpaceBackgroundCanvas?>
<StackPane prefHeight="600.0" prefWidth="1000.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="net.eternallauncher.MainController">

    <!-- Фоновый холст -->
    <SpaceBackgroundCanvas fx:id="bgCanvas" />

    <!-- UI Панели -->
    <VBox spacing="0">
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <TextField fx:id="usernameField" promptText="Никнейм" prefHeight="45.0" prefWidth="180.0"
                       style="-fx-background-color: rgba(0, 0, 0, 0.4); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255, 255, 255, 0.4); -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-radius: 8;"/>

            <ComboBox fx:id="versionComboBox" prefHeight="45.0" prefWidth="260.0"
                      style="-fx-background-color: rgba(0, 0, 0, 0.4); -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-radius: 8;"/>

            <Button fx:id="playButton" onAction="#onPlayButtonClick" text="ИГРАТЬ" prefHeight="45.0" prefWidth="150.0"
                    style="-fx-background-color: rgba(46, 204, 113, 0.45); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(46, 204, 113, 0.6); -fx-border-radius: 8; -fx-cursor: hand;"/>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="settingsButton" text="⚙" prefHeight="45.0" prefWidth="45.0"
                    style="-fx-background-color: rgba(0, 0, 0, 0.4); -fx-text-fill: rgba(255, 255, 255, 0.8); -fx-font-size: 18px; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-radius: 8; -fx-cursor: hand;"/>
        </HBox>

        <VBox alignment="CENTER" VBox.vgrow="ALWAYS" spacing="10.0">
            <Label fx:id="statusLabel" text="Версия не выбрана" textFill="#ffffff"
                   style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 10, 0.5, 0, 0);">
                <font>
                    <Font size="16.0"/>
                </font>
            </Label>
        </VBox>
    </VBox>

</StackPane>