<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- ОБЯЗАТЕЛЬНЫЙ ИМПОРТ -->
<?import net.eternallauncher.ui.background.SpaceBackgroundCanvas?>

<StackPane prefHeight="600.0" prefWidth="1000.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="net.eternallauncher.MainController"
           stylesheets="@style.css">

    <!-- Фоновый холст -->
    <SpaceBackgroundCanvas fx:id="bgCanvas" />

    <!-- Главный контейнер интерфейса -->
    <VBox alignment="TOP_CENTER" spacing="0">

        <!-- Верхняя панель управления -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <TextField fx:id="usernameField" promptText="Никнейм" prefHeight="45.0" prefWidth="180.0"
                       style="-fx-background-color: rgba(0, 0, 0, 0.4); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255, 255, 255, 0.4); -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-radius: 8;"/>

            <ComboBox fx:id="versionComboBox" prefHeight="45.0" prefWidth="250.0"
                      style="-fx-font-size: 14px;"/>

            <Button fx:id="playButton" onAction="#onPlayButtonClick" text="ИГРАТЬ" prefHeight="45.0" prefWidth="150.0"
                    style="-fx-background-color: rgba(46, 204, 113, 0.45); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(46, 204, 113, 0.6); -fx-border-radius: 8; -fx-cursor: hand;"/>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Кнопка настроек в верхнем правом углу -->
            <Button fx:id="settingsButton" text="⚙" prefHeight="45.0" prefWidth="45.0"
                    style="-fx-background-color: rgba(0, 0, 0, 0.4); -fx-text-fill: rgba(255, 255, 255, 0.8); -fx-font-size: 18px; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-radius: 8; -fx-cursor: hand;"/>
        </HBox>

        <!-- Растягиваем пространство -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Нижняя панель через AnchorPane: кнопка намертво привязана справа, прогресс заполняет левую часть -->
        <AnchorPane style="-fx-background-color: transparent;" prefHeight="75.0">
            <padding>
                <Insets top="15.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <!-- Контейнер для прогресс-бара: растягивается слева (20px от края) до кнопки (на 175px от правого края) -->
            <StackPane fx:id="progressContainer" prefHeight="40.0"
                       AnchorPane.leftAnchor="20.0"
                       AnchorPane.rightAnchor="175.0"
                       AnchorPane.topAnchor="15.0" />

            <!-- Кнопка папки версии: ВСЕГДА жестко закреплена справа -->
            <Button fx:id="openFolderButton" onAction="#onOpenVersionFolderClick" text="📁 Папка версии"
                    prefHeight="40.0" prefWidth="140.0"
                    AnchorPane.rightAnchor="20.0"
                    AnchorPane.topAnchor="15.0"
                    style="-fx-background-color: rgba(0, 0, 0, 0.4); -fx-text-fill: rgba(255, 255, 255, 0.8); -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-radius: 8; -fx-cursor: hand;"/>
        </AnchorPane>

    </VBox>

</StackPane>